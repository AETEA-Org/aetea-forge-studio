# ---------------------------------------------------------------------------
# aetea-forge-studio — frontend configuration
#
# Copy to `.env` for local development. The values below ARE the local ones:
# they point at the Supabase stack that `supabase start` runs in Docker, and at
# a backend running on this machine. Nothing here reaches the cloud.
#
# Every VITE_* value is inlined into the JavaScript bundle at BUILD time, so
# anyone who opens the site can read it. Never put a secret here. The Supabase
# publishable key is designed to be public — Row Level Security is what protects
# the data, not the key.
#
# dev and prod set these in their Vercel deployment's environment variables, not
# in a file. See .aetea/env/{dev,prod}.vercel.env in the workspace root.
# ---------------------------------------------------------------------------

# The AETEA backend. Local default matches `uvicorn --port 8000`.
#   dev  → https://api-dev.aetea.studio
#   prod → https://api.aetea.studio
VITE_API_BASE_URL=http://localhost:8000

# Supabase. These are the fixed values `supabase start` always prints — the
# local anon key is the same on every machine and is not a secret.
#   dev  → https://jfvwhnsbhumdlibdomzv.supabase.co
#   prod → https://nytzgmajhgzvxlniqkgw.supabase.co
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=<run `supabase status` and copy the anon key>
VITE_SUPABASE_PROJECT_ID=local

# ---------------------------------------------------------------------------
# Removed, and not to be reinstated
#
# VITE_AETEA_API_TOKEN — a Hugging Face token that existed only to get past the
# private Space's gate, and which shipped in the browser bundle where anyone
# could read it. The Space is gone (issue #102) and so is the reason for it.
# ---------------------------------------------------------------------------
